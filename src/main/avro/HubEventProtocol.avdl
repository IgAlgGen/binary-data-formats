@namespace("ru.yandex.practicum.avro")
protocol HubEventProtocol {
enum DeviceType {
    MOTION_SENSOR,
    TEMPERATURE_SENSOR,
    LIGHT_SENSOR
  }

  record DeviceAddedEvent {
    string id;
    DeviceType type;
  }

  record DeviceRemovedEvent {
    string id;
  }

  record HubEvent {
    string hub_id;

    @logicalType("timestamp-millis")
    long timestamp;

    // Union из двух событий
    union { DeviceAddedEvent, DeviceRemovedEvent } payload;
  }
}